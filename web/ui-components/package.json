{
	"name": "@osp/ui-components",
	"private": true,
	"version": "0.0.0",
	"license": "MIT",
	"description": "Shared Svelte components for the builder. Must not import @osp/api-client.",
	"type": "module",
	"svelte": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./survey": {
			"types": "./src/survey/index.ts",
			"svelte": "./src/survey/index.ts",
			"default": "./src/survey/index.ts"
		},
		"./tokens.css": "./src/tokens.css"
	},
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
	},
	"dependencies": {
		"@lucide/svelte": "^1.50.0",
		"bits-ui": "^2.19.5"
	},
	"peerDependencies": {
		"svelte": "^5.57.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.8",
		"jsdom": "^30.1.3",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "~6.0.3",
		"vitest": "^4.1.12"
	},
	"sideEffects": [
		"**/*.css"
	]
}
