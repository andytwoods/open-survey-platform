{
  "name": "osp-web",
  "private": true,
  "description": "pnpm workspace root for the web half of Open Survey Platform",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @osp/builder build",
    "check": "pnpm -r --if-present check && pnpm lint && pnpm depcruise",
    "lint": "eslint .",
    "depcruise": "depcruise builder/src ui-components/src api-client/src --config .dependency-cruiser.cjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.4.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "svelte": "^5.57.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
