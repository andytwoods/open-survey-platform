{
	"name": "@osp/runtime",
	"private": true,
	"version": "0.1.0",
	"license": "MIT",
	"description": "Participant app: Svelte 5 + Vite, static. Runs @osp/engine in the browser; the server only saves.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && vitest run",
		"size": "node scripts/size.mjs",
		"e2e": "playwright test"
	},
	"dependencies": {
		"@osp/engine": "workspace:*",
		"@osp/ui-components": "workspace:*"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@osp/api-client": "workspace:*",
		"@playwright/test": "^1.64.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"fake-indexeddb": "^6.2.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^4.1.12"
	}
}
