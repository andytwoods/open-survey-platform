{
	"name": "@osp/engine-sim",
	"private": true,
	"version": "0.1.0",
	"license": "MIT",
	"description": "Simulator and path coverage for runtime plans: runs @osp/engine for N simulated participants (task M1). Pure, plus a stdin/stdout CLI for the server's Node sidecar.",
	"type": "module",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"sideEffects": false,
	"scripts": {
		"check": "tsc -p tsconfig.json",
		"build": "vite build --logLevel warn"
	},
	"dependencies": {
		"@osp/engine": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^4.1.12"
	}
}
