{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024", "dom"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": false,
		"noUncheckedIndexedAccess": true
	},
	"include": ["src"]
}
