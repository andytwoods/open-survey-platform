		"text": {
			"en": "This is a short demo survey about coffee, sleep and focus. It takes about three minutes. Taking part is voluntary, and in this demo nothing you enter leaves your browser.",
			"de": "Dies ist eine kurze Demo-Umfrage über Kaffee, Schlaf und Konzentration. Sie dauert etwa drei Minuten. Die Teilnahme ist freiwillig, und in dieser Demo verlässt nichts, was Sie eingeben, Ihren Browser."
		},
		"agreeLabel": {
			"en": "I agree to take part",
			"de": "Ich bin einverstanden"
		},
		"declineLabel": {
			"en": "No, thanks",
			"de": "Nein, danke"
		},
		"declineOutcome": "declined"
	},
