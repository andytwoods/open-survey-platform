	"flow": [
		{
			"type": "block",
			"id": "n_about",
			"block": "about_you"
		},
		{
			"type": "branch",
			"id": "br_age",
			"if": {
				"kind": "compare",
				"op": "<",
				"left": {
					"kind": "ref",
					"id": "age"
				},
				"right": {
					"kind": "int",
					"value": 18
				}
			},
			"then": [
				{
					"type": "end",
					"id": "end_too_young",
					"outcome": "too_young"
				}
			]
		},
		{
			"type": "branch",
			"id": "br_coffee",
			"if": {
				"kind": "compare",
				"op": "==",
				"left": {
					"kind": "ref",
					"id": "drinks_coffee"
				},
				"right": {
					"kind": "text",
					"value": "yes"
				}
			},
			"then": [
				{
					"type": "block",
					"id": "n_coffee",
					"block": "coffee"
				}
			],
			"else": [
				{
					"type": "block",
					"id": "n_no_coffee",
					"block": "no_coffee"
				}
			]
		},
		{
			"type": "randomiser",
			"id": "r_focus_sleep",
			"children": [
				{
					"type": "block",
					"id": "n_focus",
					"block": "focus"
				},
				{
					"type": "block",
					"id": "n_sleep",
					"block": "sleep"
				}
			]
		},
		{
			"type": "block",
			"id": "n_wrap",
			"block": "wrap_up"
		},
		{
			"type": "end",
			"id": "end_complete"
		}
	]
}
