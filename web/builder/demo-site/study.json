		"endings": {
			"complete": {
				"title": {
					"en": "Thank you!",
					"de": "Vielen Dank!"
				},
				"body": {
					"en": "That's everything. Your answers help our (entirely invented) lab understand how coffee, sleep and focus fit together.",
					"de": "Das war alles. Ihre Antworten helfen unserem (frei erfundenen) Labor zu verstehen, wie Kaffee, Schlaf und Konzentration zusammenhängen."
				},
				"summary": "answers"
			},
			"too_young": {
				"title": {
					"en": "Thanks for your interest",
					"de": "Danke für Ihr Interesse"
				},
				"body": {
					"en": "This study is for adults (18 or over), so we can't include you this time. Nothing else is needed from you.",
					"de": "Diese Studie richtet sich an Erwachsene (ab 18 Jahren), daher können wir Sie diesmal nicht aufnehmen. Mehr brauchen wir nicht von Ihnen."
				}
			},
			"declined": {
				"body": {
					"en": "No problem: you chose not to take part.",
					"de": "Kein Problem: Sie haben sich gegen die Teilnahme entschieden."
				}
			}
		}
	},
