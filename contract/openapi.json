{
  "components": {
    "schemas": {
      "AnswerIn": {
        "additionalProperties": true,
        "properties": {
          "state": {
            "enum": [
              "answered",
              "unanswered",
              "irrelevant",
              "not-reached"
            ],
            "title": "State",
            "type": "string"
          },
          "value": {
            "title": "Value"
          }
        },
        "required": [
          "state"
        ],
        "title": "AnswerIn",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "QuotaResponse": {
        "properties": {
          "nodeId": {
            "title": "Nodeid",
            "type": "string"
          },
          "replay": {
            "title": "Replay",
            "type": "boolean"
          },
          "result": {
            "enum": [
              "admitted",
              "full"
            ],
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "nodeId",
          "result",
          "replay"
        ],
        "title": "QuotaResponse",
        "type": "object"
      },
      "ResponseRecordIn": {
        "additionalProperties": true,
        "description": "The engine's ``result(state)``. Extra fields are stored as sent.",
        "properties": {
          "answers": {
            "additionalProperties": {
              "$ref": "#/components/schemas/AnswerIn"
            },
            "title": "Answers",
            "type": "object"
          },
          "assigned": {
            "additionalProperties": true,
            "title": "Assigned",
            "type": "object"
          },
          "engineVersion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Engineversion"
          },
          "events": {
            "items": {},
            "title": "Events",
            "type": "array"
          },
          "orders": {
            "additionalProperties": true,
            "title": "Orders",
            "type": "object"
          },
          "planChecksum": {
            "title": "Planchecksum",
            "type": "string"
          },
          "sessionId": {
            "title": "Sessionid",
            "type": "string"
          }
        },
        "required": [
          "sessionId",
          "planChecksum",
          "assigned",
          "answers"
        ],
        "title": "ResponseRecordIn",
        "type": "object"
      },
      "ResumeResponse": {
        "properties": {
          "assigned": {
            "additionalProperties": true,
            "title": "Assigned",
            "type": "object"
          },
          "planChecksum": {
            "title": "Planchecksum",
            "type": "string"
          },
          "planUrl": {
            "title": "Planurl",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "saveMode": {
            "enum": [
              "every-page",
              "end-only"
            ],
            "title": "Savemode",
            "type": "string"
          },
          "sessionId": {
            "title": "Sessionid",
            "type": "string"
          },
          "sessionSeed": {
            "title": "Sessionseed",
            "type": "integer"
          },
          "snapshot": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot"
          },
          "submitted": {
            "title": "Submitted",
            "type": "boolean"
          }
        },
        "required": [
          "sessionId",
          "revision",
          "snapshot",
          "sessionSeed",
          "assigned",
          "planUrl",
          "planChecksum",
          "saveMode",
          "submitted"
        ],
        "title": "ResumeResponse",
        "type": "object"
      },
      "SnapshotRequest": {
        "additionalProperties": false,
        "properties": {
          "baseRevision": {
            "minimum": 0.0,
            "title": "Baserevision",
            "type": "integer"
          },
          "snapshot": {
            "additionalProperties": true,
            "title": "Snapshot",
            "type": "object"
          }
        },
        "required": [
          "baseRevision",
          "snapshot"
        ],
        "title": "SnapshotRequest",
        "type": "object"
      },
      "SnapshotResponse": {
        "properties": {
          "replay": {
            "description": "True when this was a retry of the last accepted write.",
            "title": "Replay",
            "type": "boolean"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "revision",
          "replay"
        ],
        "title": "SnapshotResponse",
        "type": "object"
      },
      "StaleBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "snapshot": {
            "title": "Snapshot"
          }
        },
        "required": [
          "code",
          "message",
          "revision"
        ],
        "title": "StaleBody",
        "type": "object"
      },
      "StartRequest": {
        "additionalProperties": false,
        "properties": {
          "urlParams": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "URL parameters (e.g. a Prolific id). Not stored in end-only mode.",
            "title": "Urlparams",
            "type": "object"
          }
        },
        "title": "StartRequest",
        "type": "object"
      },
      "StartResponse": {
        "properties": {
          "assigned": {
            "additionalProperties": true,
            "title": "Assigned",
            "type": "object"
          },
          "planChecksum": {
            "title": "Planchecksum",
            "type": "string"
          },
          "planUrl": {
            "title": "Planurl",
            "type": "string"
          },
          "resumeToken": {
            "description": "Secret. Send as `Authorization: Bearer <token>`.",
            "title": "Resumetoken",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "saveMode": {
            "enum": [
              "every-page",
              "end-only"
            ],
            "title": "Savemode",
            "type": "string"
          },
          "sessionId": {
            "title": "Sessionid",
            "type": "string"
          },
          "sessionSeed": {
            "maximum": 9007199254740991.0,
            "minimum": 1.0,
            "title": "Sessionseed",
            "type": "integer"
          }
        },
        "required": [
          "sessionId",
          "resumeToken",
          "sessionSeed",
          "assigned",
          "planUrl",
          "planChecksum",
          "saveMode",
          "revision"
        ],
        "title": "StartResponse",
        "type": "object"
      },
      "SubmitResponse": {
        "properties": {
          "replay": {
            "title": "Replay",
            "type": "boolean"
          },
          "responseId": {
            "title": "Responseid",
            "type": "string"
          },
          "submittedAt": {
            "format": "date-time",
            "title": "Submittedat",
            "type": "string"
          }
        },
        "required": [
          "responseId",
          "submittedAt",
          "replay"
        ],
        "title": "SubmitResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VersionInfo": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "title": "VersionInfo",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "The session's resume token.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Open Survey Platform API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/s/{slug}/plan/{checksum}": {
      "get": {
        "operationId": "getPlan",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "checksum",
            "required": true,
            "schema": {
              "title": "Checksum",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Getplan",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Plan",
        "tags": [
          "participant"
        ]
      }
    },
    "/api/s/{slug}/sessions": {
      "post": {
        "operationId": "startSession",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/StartRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Gone"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too Many Requests"
          }
        },
        "summary": "Start Session",
        "tags": [
          "participant"
        ]
      }
    },
    "/api/sessions/resume": {
      "get": {
        "operationId": "resumeSession",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Gone"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too Many Requests"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Resume",
        "tags": [
          "participant"
        ]
      }
    },
    "/api/sessions/{session_id}/quota/{node_id}": {
      "post": {
        "operationId": "checkQuota",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "node_id",
            "required": true,
            "schema": {
              "title": "Node Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuotaResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaleBody"
                }
              }
            },
            "description": "Conflict"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Gone"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Check Quota",
        "tags": [
          "participant"
        ]
      }
    },
    "/api/sessions/{session_id}/snapshot": {
      "put": {
        "operationId": "saveSnapshot",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SnapshotRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaleBody"
                }
              }
            },
            "description": "Conflict"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Gone"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Content Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Save Snapshot",
        "tags": [
          "participant"
        ]
      }
    },
    "/api/sessions/{session_id}/submit": {
      "post": {
        "operationId": "submitSession",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResponseRecordIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaleBody"
                }
              }
            },
            "description": "Conflict"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Gone"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Content Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Submit",
        "tags": [
          "participant"
        ]
      }
    },
    "/api/version": {
      "get": {
        "operationId": "getVersion",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Version",
        "tags": [
          "meta"
        ]
      }
    }
  }
}
