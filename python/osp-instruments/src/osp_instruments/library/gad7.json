    "evidenceDate": "2026-10-17"
  },
  "citation": {
    "text": "Spitzer RL, Kroenke K, Williams JBW, Löwe B (2006). A brief measure for assessing generalized anxiety disorder: the GAD-7. Archives of Internal Medicine 166(10):1092–1097.",
    "doi": "10.1001/archinte.166.10.1092"
  },
