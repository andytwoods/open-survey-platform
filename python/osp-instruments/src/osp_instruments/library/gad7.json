  "title": "Generalized Anxiety Disorder-7",
  "abbreviation": "GAD-7",
  "description": "Seven items on how often anxiety symptoms bothered the respondent over the last two weeks, 0–3 each. A screening aid, not a diagnosis.",
  "tags": [
    "anxiety",
    "screener",
    "mental-health",
    "gad"
  ],
