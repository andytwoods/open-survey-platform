          "items": [
            {
              "id": "mini_ipip_instructions",
              "type": "note",
              "label": "Describe yourself as you generally are now, not as you wish to be in the future. Describe yourself as you honestly see yourself, in relation to other people you know of the same sex as you are, and roughly your same age. So that you can describe yourself in an honest manner, your responses will be kept in absolute confidence. Indicate for each statement whether it is 1. Very Inaccurate, 2. Moderately Inaccurate, 3. Neither Accurate Nor Inaccurate, 4. Moderately Accurate, or 5. Very Accurate as a description of you."
            },
            {
              "id": "mini_ipip",
              "type": "matrix",
              "label": "How Accurately Can You Describe Yourself?",
              "choiceList": "ipip_accuracy",
              "rows": [
                {
                  "id": "q1",
                  "label": "Am the life of the party."
                },
                {
                  "id": "q2",
                  "label": "Sympathize with others' feelings."
                },
                {
                  "id": "q3",
                  "label": "Get chores done right away."
                },
                {
                  "id": "q4",
                  "label": "Have frequent mood swings."
                },
                {
                  "id": "q5",
                  "label": "Have a vivid imagination."
                },
                {
                  "id": "q6",
                  "label": "Talk to a lot of different people at parties."
                },
                {
                  "id": "q7",
                  "label": "Feel others' emotions."
                },
                {
                  "id": "q8",
                  "label": "Like order."
                },
                {
                  "id": "q9",
                  "label": "Get upset easily."
                },
                {
                  "id": "q10",
                  "label": "Have difficulty understanding abstract ideas."
                },
                {
                  "id": "q11",
                  "label": "Don't talk a lot."
                },
                {
                  "id": "q12",
                  "label": "Am not really interested in others."
                },
                {
                  "id": "q13",
                  "label": "Often forget to put things back in their proper place."
                },
                {
                  "id": "q14",
                  "label": "Am relaxed most of the time."
                },
                {
                  "id": "q15",
                  "label": "Am not interested in abstract ideas."
                },
                {
                  "id": "q16",
                  "label": "Keep in the background."
                },
                {
                  "id": "q17",
                  "label": "Am not interested in other people's problems."
                },
                {
                  "id": "q18",
                  "label": "Make a mess of things."
                },
                {
                  "id": "q19",
                  "label": "Seldom feel blue."
                },
                {
