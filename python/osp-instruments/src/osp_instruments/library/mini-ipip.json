{
  "bankVersion": "osp-bank-item/0.1",
  "id": "mini-ipip",
  "version": 1,
  "kind": "block",
  "title": "Mini-IPIP (20-item Big Five)",
  "abbreviation": "Mini-IPIP",
  "description": "Twenty IPIP items, four per Big Five factor, answered on the IPIP five-point accuracy scale. The IPIP key page gives no administration order: the items are interleaved by factor (Extraversion, Agreeableness, Conscientiousness, Neuroticism, Intellect/Imagination) in the order the key lists them.",
  "tags": [
    "personality",
    "big-five",
    "ipip"
  ],
  "languages": [
    "en"
  ],
  "licence": {
    "class": "public-domain",
    "holder": "International Personality Item Pool (Oregon Research Institute; Lewis R. Goldberg)",
    "statement": "Because the IPIP has been placed in the public domain, permission has already been automatically granted for any person to use IPIP items, scales, and inventories for any purpose, commercial or non-commercial.. It is not necessary to contact the IPIP site author (Lew Goldberg) or the IPIP Consultant (John A. Johnson) for permission to use IPIP materials. (Home page: \"The items and scales are in the public domain, which means that one can copy, edit, translate, or use them for any purpose without asking permission and without paying a fee.\")",
    "url": "https://ipip.ori.org/newPermission.htm",
    "evidenceDate": "2026-10-17"
  },
  "citation": {
    "text": "Donnellan MB, Oswald FL, Baird BM, Lucas RE (2006). The Mini-IPIP scales: tiny-yet-effective measures of the Big Five factors of personality. Psychological Assessment 18(2):192–203.",
    "doi": "10.1037/1040-3590.18.2.192"
  },
  "source": {
    "url": "https://ipip.ori.org/MiniIPIPKey.htm",
    "note": "Items and keys from the IPIP Mini-IPIP key page; instructions and response labels from https://ipip.ori.org/New_IPIP-50-item-scale.htm (\"These are suggestions, not requirements\"); read 2026-10-17."
  },
  "scoring": {
    "text": "Each scale is the sum of its four items (4–20), + keyed items scored 1–5 and − keyed items 6 − answer, as on https://ipip.ori.org/newScoringInstructions.htm. Factor IV is scored as Neuroticism (high = less emotionally stable), as the Mini-IPIP authors chose. Items: extraversion: q1, q6, q11 (reversed), q16 (reversed); agreeableness: q2, q7, q12 (reversed), q17 (reversed); conscientiousness: q3, q8, q13 (reversed), q18 (reversed); neuroticism: q4, q9, q14 (reversed), q19 (reversed); intellect: q5, q10 (reversed), q15 (reversed), q20 (reversed)."
  },
