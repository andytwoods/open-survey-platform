      "Element": "SQ",
      "PrimaryAttribute": "QID1",
      "SecondaryAttribute": "Welcome Please answer every question. It takes two minutes . What you need Your participant code The",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<h3>Welcome</h3><p>Please answer <strong>every</strong> question.<br />It takes <em>two minutes</em>.</p><h4>What you need</h4><ul><li>Your <strong><em>participant code</em></strong></li><li>The <a href=\"https://example.org/study\" target=\"_blank\" rel=\"noopener noreferrer\">study page</a> open</li></ul><p><span lang=\"fr\">Merci</span> and thank you.</p>",
        "DefaultChoices": false,
        "DataExportTag": "intro",
        "QuestionType": "DB",
        "Selector": "TB",
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "Welcome Please answer every question. It takes two minutes . What you need Your participant code The study page open Merci and thank you.",
        "Language": {
          "AR": {
            "QuestionText": "<h3>مرحباً</h3><p>يرجى الإجابة على <strong>كل</strong> سؤال. <span lang=\"en\"><em>two minutes</em></span></p><ul><li><strong>رمز المشارك</strong></li><li><a href=\"https://example.org/study\" target=\"_blank\" rel=\"noopener noreferrer\">صفحة الدراسة</a></li></ul>"
          }
        },
