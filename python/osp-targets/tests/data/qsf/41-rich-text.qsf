        "Selector": "TB",
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "Finished Goodbye, ${q://QID2/ChoiceTextEntryValue} ! All done Thank you, ${q://QID2/ChoiceTextEntryValue}. Your fruit: ${q://QID3/ChoiceGroup/SelectedChoices} Your rating: ${q://QID5/ChoiceTextEntryVa",
