      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<h3>Finished</h3><p>Goodbye, ${q://QID2/ChoiceTextEntryValue}<strong>!</strong></p><p>All <strong>done</strong></p><p>Thank you, ${q://QID2/ChoiceTextEntryValue}.</p><ul><li>Your fruit: ${q://QID3/ChoiceGroup/SelectedChoices}</li><li>Your rating: ${q://QID5/ChoiceTextEntryValue}</li></ul>",
