      },
      "block": "p1",
      "page": "p1_page",
      "required": true,
      "choices": [
        {
          "code": "coffee",
          "label": {
            "en": "Coffee",
            "de": "Kaffee"
          }
        },
        {
          "code": "tea",
          "label": {
            "en": "Tea",
            "de": "Tee"
          }
        }
      ],
