    <qid><![CDATA[1]]></qid>
    <question><![CDATA[<h3>Welcome</h3><p>Please answer <strong>every</strong> question.<br />It takes <em>two minutes</em>.</p><h4>What you need</h4><ul><li>Your <strong><em>participant code</em></strong></li><li>The <a href="https://example.org/study" target="_blank" rel="noopener noreferrer">study page</a> open</li></ul><p><span lang="fr">Merci</span> and thank you.</p>]]></question>
    <help/>
    <script/>
    <language><![CDATA[en]]></language>
   </row>
   <row>
    <id><![CDATA[2]]></id>
