  <rows>
   <row>
    <surveyls_survey_id><![CDATA[770446]]></surveyls_survey_id>
    <surveyls_language><![CDATA[en]]></surveyls_language>
    <surveyls_title><![CDATA[Rich text in every field]]></surveyls_title>
    <surveyls_description><![CDATA[planning/rich-text.md §3 (task RT2): the rich-text model end to end. Block fields (a note, the consent text, the end message) carry headings and lists; stems (labels, help) carry marks, links and pipes; inline fields (choice, row and column labels, slider end labels, the page title, the constraint message, the consent buttons) carry one paragraph. Pipes sit inside formatting. Arabic is a second language with a rich RTL label; one label has no Arabic and falls back.]]></surveyls_description>
    <surveyls_welcometext/>
    <surveyls_endtext><![CDATA[<p>All <strong>done</strong></p><p>Thank you, {name}.</p><ul><li>Your fruit: {fav.shown}</li><li>Your rating: {rate}</li></ul>]]></surveyls_endtext>
    <surveyls_dateformat><![CDATA[1]]></surveyls_dateformat>
    <surveyls_numberformat><![CDATA[0]]></surveyls_numberformat>
   </row>
   <row>
    <surveyls_survey_id><![CDATA[770446]]></surveyls_survey_id>
    <surveyls_language><![CDATA[ar]]></surveyls_language>
    <surveyls_title><![CDATA[Rich text in every field]]></surveyls_title>
    <surveyls_description><![CDATA[planning/rich-text.md §3 (task RT2): the rich-text model end to end. Block fields (a note, the consent text, the end message) carry headings and lists; stems (labels, help) carry marks, links and pipes; inline fields (choice, row and column labels, slider end labels, the page title, the constraint message, the consent buttons) carry one paragraph. Pipes sit inside formatting. Arabic is a second language with a rich RTL label; one label has no Arabic and falls back.]]></surveyls_description>
    <surveyls_welcometext/>
    <surveyls_endtext><![CDATA[<p>All <strong>done</strong></p><p>Thank you, {name}.</p><ul><li>Your fruit: {fav.shown}</li><li>Your rating: {rate}</li></ul>]]></surveyls_endtext>
