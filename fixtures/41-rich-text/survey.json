  "metadata": {
    "title": "Rich text in every field",
    "description": {
      "type": "rich",
      "blocks": [
        {
          "type": "p",
          "content": [
            {
              "text": "planning/rich-text.md §3 (task RT2): the rich-text model end to end. Block fields (a note, the consent text, the end message) carry headings and lists; stems (labels, help) carry marks, links and pipes; inline fields (choice, row and column labels, slider end labels, the page title, the constraint message, the consent buttons) carry one paragraph. Pipes sit inside formatting. Arabic is a second language with a rich RTL label; one label has no Arabic and falls back."
            }
          ]
        }
      ]
    },
    "languages": [
      "en",
      "ar"
    ],
    "defaultLanguage": "en"
  },
