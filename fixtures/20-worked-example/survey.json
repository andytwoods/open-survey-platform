{
  "specVersion": "osp-survey/0.1",
  "id": "srv_7f3c",
  "version": 3,
  "metadata": {
    "title": "Framing and incentive study",
    "description": "review.md §2.3 in full: consent gate, constraint, calculate, quota, 2x2 assign, branch, shuffled block, piping, score. Partly pending (C3a-1..5).",
    "languages": [
      "en",
      "de"
    ],
    "license": "CC-BY-4.0",
    "ddi": {
      "universe": "UK adults 18+",
      "studyUnit": "doi:10.xxxx/placeholder"
    }
  },
  "settings": {
    "backNavigation": true
  },
  "choiceLists": [
    {
      "id": "yesno",
      "choices": [
        {
          "value": 1,
          "label": {
            "en": "Yes",
            "de": "Ja"
          }
        },
        {
          "value": 0,
          "label": {
            "en": "No",
            "de": "Nein"
          }
        }
      ]
    },
    {
      "id": "agree5",
      "choices": [
        {
          "value": 1,
          "label": "Strongly disagree"
        },
        {
          "value": 2,
          "label": "Disagree"
        },
        {
          "value": 3,
          "label": "Neutral"
        },
        {
          "value": 4,
          "label": "Agree"
        },
        {
          "value": 5,
          "label": "Strongly agree"
        }
      ]
    }
  ],
  "variables": [
    {
      "kind": "embedded",
      "id": "source",
      "param": "src",
      "default": "direct"
    },
    {
      "kind": "assigned",
      "id": "framing",
      "levels": [
        "gain",
        "loss"
      ]
    },
    {
      "kind": "assigned",
      "id": "incentive",
      "levels": [
        "£5 voucher",
        "charity donation"
      ]
    }
  ],
  "blocks": [
    {
      "id": "consent_blk",
      "pages": [
        {
          "id": "consent_blk_page",
          "items": [
            {
              "type": "single",
              "id": "consent",
              "label": {
                "en": "Do you consent to take part?"
              },
              "choiceList": "yesno",
              "required": true
            }
          ]
        }
      ]
    },
    {
      "id": "demo",
      "pages": [
        {
          "id": "demo_page",
          "items": [
            {
              "type": "integer",
              "id": "age",
              "label": "How old are you?",
              "required": true,
              "constraint": {
                "kind": "and",
                "args": [
                  {
                    "kind": "compare",
                    "op": ">=",
                    "left": {
                      "kind": "ref",
                      "id": "age"
                    },
                    "right": {
                      "kind": "int",
                      "value": 18
                    }
                  },
                  {
                    "kind": "compare",
                    "op": "<=",
                    "left": {
                      "kind": "ref",
                      "id": "age"
                    },
                    "right": {
                      "kind": "int",
                      "value": 120
                    }
                  }
                ]
              },
              "constraintMessage": "Please enter an age between 18 and 120."
            }
          ]
        }
      ]
    },
    {
      "id": "stim_gain",
      "pages": [
        {
          "id": "stim_gain_page",
          "items": [
            {
              "type": "note",
              "id": "stim_g",
              "label": "Programme A saves 200 people…"
            }
          ]
        }
      ]
    },
    {
      "id": "stim_loss",
      "pages": [
        {
          "id": "stim_loss_page",
          "items": [
            {
              "type": "note",
              "id": "stim_l",
              "label": "With Programme A, 400 people die…"
            }
          ]
        }
      ]
    },
    {
      "id": "attitudes",
      "pages": [
        {
          "id": "attitudes_page",
          "items": [
            {
              "type": "single",
              "id": "att1",
              "label": "With the ${incentive} you were offered, the programme seems fair.",
              "choiceList": "agree5"
            },
            {
              "type": "single",
              "id": "att2",
              "label": "I would support Programme A.",
              "choiceList": "agree5"
            },
            {
              "type": "single",
              "id": "att3",
              "label": "Programme A is too risky.",
              "choiceList": "agree5"
            }
          ],
          "itemOrder": "shuffle"
        }
      ]
    },
    {
      "id": "screenout",
      "pages": [
        {
          "id": "screenout_page",
          "items": [
            {
              "type": "note",
              "id": "bye",
              "label": "Thank you. This study is now closed."
            }
          ]
        }
      ]
    }
  ],
  "flow": [
    {
      "type": "block",
      "id": "n_consent_blk",
      "block": "consent_blk"
    },
    {
      "type": "branch",
      "id": "branch_1",
      "if": {
        "kind": "compare",
        "op": "==",
        "left": {
          "kind": "ref",
          "id": "consent"
        },
        "right": {
          "kind": "int",
          "value": 0
        }
      },
      "then": [
        {
          "type": "end",
          "id": "end_declined",
          "outcome": "declined"
        }
      ]
    },
    {
      "type": "block",
      "id": "n_demo",
      "block": "demo"
    },
    {
      "type": "assign",
      "id": "assign_design",
      "variables": [
        "framing",
        "incentive"
      ]
    },
    {
      "type": "branch",
      "id": "branch_2",
      "if": {
        "kind": "compare",
        "op": "==",
        "left": {
          "kind": "ref",
          "id": "framing"
        },
        "right": {
          "kind": "text",
          "value": "gain"
        }
      },
      "then": [
        {
          "type": "block",
          "id": "n_stim_gain",
          "block": "stim_gain"
        }
      ],
      "else": [
        {
          "type": "block",
          "id": "n_stim_loss",
          "block": "stim_loss"
        }
      ]
    },
    {
      "type": "block",
      "id": "n_attitudes",
      "block": "attitudes"
    },
    {
      "type": "end",
      "id": "end_complete"
    }
  ]
}
