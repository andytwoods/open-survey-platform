{
  "specVersion": "osp-survey/0.1",
  "id": "f17_piping",
  "version": 1,
  "metadata": {
    "title": "Piping",
    "description": "§8 piping: choice label, raw values, HTML escaping, empty for missing values.",
    "languages": [
      "en"
    ]
  },
  "settings": {
    "backNavigation": true
  },
  "choiceLists": [
    {
      "id": "fruit3",
      "choices": [
        {
          "value": "apple",
          "label": "Apple"
        },
        {
          "value": "banana",
          "label": "Banana"
        },
        {
          "value": "cherry",
          "label": "Cherry"
        }
      ]
    },
    {
      "id": "yesno",
      "choices": [
        {
          "value": "yes",
          "label": "Yes"
        },
        {
          "value": "no",
          "label": "No"
        }
      ]
    }
  ],
  "blocks": [
    {
      "id": "p1",
      "pages": [
        {
          "id": "p1_page",
          "items": [
            {
              "type": "single",
              "id": "fav_fruit",
              "label": "Which fruit do you like best?",
              "choiceList": "fruit3"
            },
            {
              "type": "integer",
              "id": "n_pets",
              "label": "How many pets would you like?"
            },
            {
              "type": "text",
              "id": "nickname",
              "label": "Choose a nickname."
            },
            {
              "type": "text",
              "id": "empty_q",
              "label": "Optional: a favourite word."
            },
            {
              "type": "single",
              "id": "skip_opt",
              "label": "Skip the optional page?",
              "choiceList": "yesno",
              "required": true
            }
          ]
        }
      ]
    },
    {
      "id": "p1b",
      "pages": [
        {
          "id": "p1b_page",
          "items": [
            {
              "type": "text",
              "id": "pet_names",
              "label": "Name them.",
              "showIf": {
                "kind": "compare",
                "op": ">",
                "left": {
                  "kind": "ref",
                  "id": "n_pets"
                },
                "right": {
                  "kind": "int",
                  "value": 5
                }
              }
            },
            {
              "type": "integer",
              "id": "plants",
              "label": "How many plants do you have?"
            }
          ]
        }
      ]
    },
    {
      "id": "p_opt",
      "pages": [
        {
          "id": "p_opt_page",
          "items": [
            {
              "type": "text",
              "id": "opt_q",
              "label": "Optional page: type anything."
            }
          ]
        }
      ]
    },
    {
      "id": "p2",
      "pages": [
        {
          "id": "p2_page",
          "items": [
            {
              "type": "text",
              "id": "pipe_choice",
              "label": "You picked ${fav_fruit}."
            },
            {
              "type": "text",
              "id": "pipe_int",
              "label": "You would like ${n_pets} pets."
            },
            {
              "type": "text",
              "id": "pipe_text",
              "label": "Hello ${nickname}!"
            },
            {
              "type": "text",
              "id": "pipe_empty",
              "label": "Favourite word: [${empty_q}]"
            },
            {
              "type": "text",
              "id": "pipe_irr",
              "label": "Pet names: [${pet_names}]"
            },
            {
              "type": "text",
              "id": "pipe_nr",
              "label": "Optional page answer: [${opt_q}]"
            }
          ]
        }
      ]
    }
  ],
  "flow": [
    {
      "type": "block",
      "id": "n_p1",
      "block": "p1"
    },
    {
      "type": "block",
      "id": "n_p1b",
      "block": "p1b"
    },
    {
      "type": "branch",
      "id": "branch_1",
      "if": {
        "kind": "compare",
        "op": "==",
        "left": {
          "kind": "ref",
          "id": "skip_opt"
        },
        "right": {
          "kind": "text",
          "value": "no"
        }
      },
      "then": [
        {
          "type": "block",
          "id": "n_p_opt",
          "block": "p_opt"
        }
      ]
    },
    {
      "type": "block",
      "id": "n_p2",
      "block": "p2"
    },
    {
      "type": "end",
      "id": "end_complete"
    }
  ]
}
