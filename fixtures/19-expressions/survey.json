{
  "specVersion": "osp-survey/0.1",
  "id": "f19_expressions",
  "version": 1,
  "metadata": {
    "title": "Expressions",
    "description": "§2/§3 expressions: + - * /, precedence, and/or/not, contains(), decimal (not float).",
    "languages": [
      "en"
    ]
  },
  "settings": {
    "backNavigation": true
  },
  "choiceLists": [
    {
      "id": "tags_list",
      "choices": [
        {
          "value": "a",
          "label": "Tag A"
        },
        {
          "value": "b",
          "label": "Tag B"
        },
        {
          "value": "c",
          "label": "Tag C"
        }
      ]
    }
  ],
  "blocks": [
    {
      "id": "p1",
      "pages": [
        {
          "id": "p1_page",
          "items": [
            {
              "type": "integer",
              "id": "x",
              "label": "Enter a whole number."
            },
            {
              "type": "decimal",
              "id": "y",
              "label": "Enter a decimal number (optional)."
            },
            {
              "type": "multi",
              "id": "tags",
              "label": "Pick some tags.",
              "choiceList": "tags_list"
            }
          ]
        }
      ]
    },
    {
      "id": "p2",
      "pages": [
        {
          "id": "p2_page",
          "items": [
            {
              "type": "text",
              "id": "p2_anchor",
              "label": "This question is always shown."
            },
            {
              "type": "text",
              "id": "e_sum",
              "label": "Shown when: x + y > 10",
              "showIf": {
                "kind": "compare",
                "op": ">",
                "left": {
                  "kind": "arith",
                  "op": "+",
                  "left": {
                    "kind": "ref",
                    "id": "x"
                  },
                  "right": {
                    "kind": "ref",
                    "id": "y"
                  }
                },
                "right": {
                  "kind": "int",
                  "value": 10
                }
              }
            },
            {
              "type": "text",
              "id": "e_div",
              "label": "Shown when: x / 4 == 2.5",
              "showIf": {
                "kind": "compare",
                "op": "==",
                "left": {
                  "kind": "arith",
                  "op": "/",
                  "left": {
                    "kind": "ref",
                    "id": "x"
                  },
                  "right": {
                    "kind": "int",
                    "value": 4
                  }
                },
                "right": {
                  "kind": "decimal",
                  "value": "2.5"
                }
              }
            },
            {
              "type": "text",
              "id": "e_dec",
              "label": "Shown when: y * 3 == 0.3",
              "showIf": {
                "kind": "compare",
                "op": "==",
                "left": {
                  "kind": "arith",
                  "op": "*",
                  "left": {
                    "kind": "ref",
                    "id": "y"
                  },
                  "right": {
                    "kind": "int",
                    "value": 3
                  }
                },
                "right": {
                  "kind": "decimal",
                  "value": "0.3"
                }
              }
            },
            {
              "type": "text",
              "id": "e_and",
              "label": "Shown when: x > 5 and contains(tags, \"b\")",
              "showIf": {
                "kind": "and",
                "args": [
                  {
                    "kind": "compare",
                    "op": ">",
                    "left": {
                      "kind": "ref",
                      "id": "x"
                    },
                    "right": {
                      "kind": "int",
                      "value": 5
                    }
                  },
                  {
                    "kind": "contains",
                    "ref": {
                      "kind": "ref",
                      "id": "tags"
                    },
                    "value": {
                      "kind": "text",
                      "value": "b"
                    }
                  }
                ]
              }
            },
            {
              "type": "text",
              "id": "e_or",
              "label": "Shown when: x < 0 or contains(tags, \"c\")",
              "showIf": {
                "kind": "or",
                "args": [
                  {
                    "kind": "compare",
                    "op": "<",
                    "left": {
                      "kind": "ref",
                      "id": "x"
                    },
                    "right": {
                      "kind": "int",
                      "value": 0
                    }
                  },
                  {
                    "kind": "contains",
                    "ref": {
                      "kind": "ref",
                      "id": "tags"
                    },
                    "value": {
                      "kind": "text",
                      "value": "c"
                    }
                  }
                ]
              }
            },
            {
              "type": "text",
              "id": "e_not",
              "label": "Shown when: not (x == 10)",
              "showIf": {
                "kind": "not",
                "arg": {
                  "kind": "compare",
                  "op": "==",
                  "left": {
                    "kind": "ref",
                    "id": "x"
                  },
                  "right": {
                    "kind": "int",
                    "value": 10
                  }
                }
              }
            },
            {
              "type": "text",
              "id": "e_prec",
              "label": "Shown when: x - 2 * 3 == 4",
              "showIf": {
                "kind": "compare",
                "op": "==",
                "left": {
                  "kind": "arith",
                  "op": "-",
                  "left": {
                    "kind": "ref",
                    "id": "x"
                  },
                  "right": {
                    "kind": "arith",
                    "op": "*",
                    "left": {
                      "kind": "int",
                      "value": 2
                    },
                    "right": {
                      "kind": "int",
                      "value": 3
                    }
                  }
                },
                "right": {
                  "kind": "int",
                  "value": 4
                }
              }
            },
            {
              "type": "text",
              "id": "e_paren",
              "label": "Shown when: (x - 2) * 3 == 24",
              "showIf": {
                "kind": "compare",
                "op": "==",
                "left": {
                  "kind": "arith",
                  "op": "*",
                  "left": {
                    "kind": "arith",
                    "op": "-",
                    "left": {
                      "kind": "ref",
                      "id": "x"
                    },
                    "right": {
                      "kind": "int",
                      "value": 2
                    }
                  },
                  "right": {
                    "kind": "int",
                    "value": 3
                  }
                },
                "right": {
                  "kind": "int",
                  "value": 24
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "flow": [
    {
      "type": "block",
      "id": "n_p1",
      "block": "p1"
    },
    {
      "type": "block",
      "id": "n_p2",
      "block": "p2"
    }
  ]
}
